# انسخ هذا الملف إلى .env وأضف قيمك الحقيقية
# Copy this file to .env and fill in your real values

# رابط الخادم (يُملأ تلقائيًا في بيئة Replit)
EXPO_PUBLIC_DOMAIN=your-replit-domain.replit.dev

# معرف تطبيق OneSignal — احصل عليه من: https://dashboard.onesignal.com
# OneSignal App ID — get it from: https://dashboard.onesignal.com
EXPO_PUBLIC_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
