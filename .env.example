# === Gaytak - Local Development Environment Variables ===
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# === PostgreSQL Database ===
# If using local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gaytak"
# If using Docker (see docker-compose.yml):
# DATABASE_URL="postgresql://gaytak:gaytak123@localhost:5432/gaytak"

# === Server Config ===
PORT=8080
BASE_PATH="/api"
NODE_ENV="development"

# === JWT / Session ===
SESSION_SECRET="your-super-secret-key-change-this-in-production"

# === Admin Account (created automatically on first run) ===
ADMIN_EMAIL="admin@gaytak.com"
ADMIN_PASSWORD="gaytak@2025"

# === OTP (Optional - for WhatsApp login) ===
# Get from https://nabdaotp.com
NABDA_API_URL="https://api.nabdaotp.com"
NABDA_INSTANCE_ID=""
NABDA_TOKEN=""

# === Firebase Notifications (Optional) ===
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVER_KEY=""

# === Cloudinary Image Upload (Optional) ===
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# === Replit Object Storage (Not needed locally) ===
# These are auto-configured on Replit
REPLIT_DOMAINS=""
REPL_ID=""

# === Logging ===
LOG_LEVEL="info"
